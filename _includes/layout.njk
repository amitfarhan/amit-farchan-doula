{%- import "macros.njk" as m -%}
<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
<!-- תצוגה מקדימה בשיתוף קישור (וואטסאפ, פייסבוק, אינסטגרם) -->
<meta property="og:type" content="website">
<meta property="og:locale" content="he_IL">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ meta.title }}">
<meta property="og:description" content="{{ meta.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/{{ meta.ogImage }}">
<meta property="og:image:width" content="{{ meta.ogImageWidth }}">
<meta property="og:image:height" content="{{ meta.ogImageHeight }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bellefair&family=Frank+Ruhl+Libre:wght@300;400;500&family=Assistant:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css?v={{ buildTime }}">
</head>
<body>
<a href="#main" class="skip-link">דלגי לתוכן הראשי</a>

<div class="announcement-bar">{{ site.announcement }}</div>

<header class="site-header">
  <div class="container nav-wrap">
    <a href="index.html" class="brand">
      <img class="brand-logo" src="{{ site.logo }}" alt="{{ site.name }}">
    </a>

    <nav class="main-nav" aria-label="ניווט ראשי">
      <ul>
        <li><a href="index.html" class="nav-link{% if active == "home" %} is-active{% endif %}">בית</a></li>
        <li><a href="index.html#about" class="nav-link">אודות</a></li>
        <li><a href="index.html#services" class="nav-link{% if active == "services" %} is-active{% endif %}">השירותים</a></li>
        <li><a href="index.html#testimonials" class="nav-link">המלצות</a></li>
        <li><a href="index.html#contact" class="nav-link">צור קשר</a></li>
      </ul>
    </nav>

    <button class="nav-toggle" aria-label="פתיחת תפריט ניווט" aria-expanded="false" aria-controls="main-nav"><span aria-hidden="true"></span></button>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-social">
      <a href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="עמוד האינסטגרם של עמית פרחן">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
      </a>
      <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="שליחת הודעת וואטסאפ">
        {{ m.whatsappIcon(16, 18, false) }}
      </a>
    </div>
    <p>{{ site.footerLine }}</p>
    <p><a href="tel:{{ site.phoneTel }}">{{ site.phoneDisplay }}</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    <p>{{ site.copyright }}</p>
  </div>
</footer>

<a class="instagram-float" href="{{ site.instagram }}" target="_blank" rel="noopener" aria-label="עמוד האינסטגרם של עמית פרחן">
  {# אותו viewBox ואותו גודל כמו אייקון הוואטסאפ, כדי ששני העיגולים ייראו זהים #}
  <svg width="26" height="28" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
</a>
<a class="whatsapp-float" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="שליחת הודעת וואטסאפ לעמית">
  {{ m.whatsappIcon(26, 28) }}
</a>

<script src="js/main.js?v={{ buildTime }}"></script>
</body>
</html>
